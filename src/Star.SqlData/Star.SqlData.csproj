<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0</TargetFrameworks>
    <RootNamespace>Star.SqlData</RootNamespace>
    <AssemblyName>Star.SqlData</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- NuGet 包元数据 -->
    <PackageId>Star.SqlData</PackageId>
    <Version>1.0.0</Version>
    <Authors>星云游(星涵)</Authors>
    <Copyright>Copyright (c) 2026 星云游(星涵)</Copyright>
    <Description>基于 MySQL 的轻量数据访问层：表名/字段名白名单校验、参数化查询、敏感字段脱敏、统一 ApiResponse 响应与通用仓储基类。</Description>
    <PackageTags>mysql;data-access;repository;sql;whitelist;aspnetcore</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/xingyungames/StarMySql</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/xingyungames/StarMySql</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MySql.Data" Version="9.4.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Star.SqlData.Tests" />
  </ItemGroup>

</Project>
