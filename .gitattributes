# 统一换行与编码，避免跨平台差异
# 仓库内与工作区统一使用 LF（与 .editorconfig 一致），仅 Windows 脚本与 .sln 用 CRLF
* text=auto eol=lf

# 源码
*.cs text diff=csharp
*.csproj text
*.props text
*.targets text
*.sln text eol=crlf
*.config text
*.sql text
*.json text
*.yml text
*.yaml text
*.md text
*.sh text eol=lf

# Windows 脚本
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# 二进制
*.dll binary
*.exe binary
*.png binary
*.jpg binary
*.ico binary
*.snk binary
*.pfx binary

# GitHub 语言统计：把生成/文档类文件排除在统计外
*.md linguist-documentation
